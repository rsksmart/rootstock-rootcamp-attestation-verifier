# =============================================================================
# Copy to .env for local dev. On Vercel: Project Settings, Environment Variables.
# Every VITE_* value is exposed in the browser bundle. Do not put server secrets in VITE_*.
# =============================================================================

# --- Required: WalletConnect / RainbowKit ---
VITE_WC_PROJECT_ID=

# --- Recommended: canonical site origin (https, no trailing slash) ---
# Production: set to your live URL so the build injects og:url, canonical, absolute og:image.
# Preview: optional; omit if you only need a throwaway deployment URL.
# VITE_SITE_URL=https://your-app.vercel.app

# --- Rootstock Testnet (chain 31): default Builder Rootcamp Hall of Fame ---
# Rootstock RPC Service (supports eth_getLogs): https://dev.rootstock.io/developers/rpc-api/rootstock/setup/
# VITE_ROOTSTOCK_TESTNET_RPC=https://rpc.testnet.rootstock.io/your-api-key

# --- Rootstock Mainnet (chain 30): Hall of Fame defaults are in src/constants/eas.ts ---
# Strongly recommended: RPC with eth_getLogs (https://dev.rootstock.io/developers/rpc-api/rootstock/setup/)
# VITE_ROOTSTOCK_MAINNET_RPC=https://rpc.rootstock.io/your-api-key
# Optional overrides if schema changes before the next code release:
# VITE_SCHEMA_UID_MAINNET=
# VITE_EAS_START_BLOCK_MAINNET=
# VITE_EAS_CONTRACT_MAINNET=
# VITE_RAS_ATTESTATION_BASE_MAINNET=https://explorer.rootstock.io/ras/attestation
